[Unit]
Description=CUTOFF network device control console
Documentation=file:///opt/cutoff/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cutoff
Environment=CUTOFF_HOST=127.0.0.1
Environment=CUTOFF_PORT=8848
Environment=CUTOFF_DATA_DIR=/var/lib/cutoff
Environment=CUTOFF_SIMULATE=auto
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cutoff/.venv/bin/python /opt/cutoff/backend/app.py
Restart=always
RestartSec=3
StartLimitBurst=5

# --- hardening -------------------------------------------------------------
# NET_ADMIN for ip(6)tables, NET_RAW for the ARP sweep; everything else dropped.
# The app writes only inside the data dir (/var/lib/cutoff).
UMask=0077
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/var/lib/cutoff
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cutoff
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
